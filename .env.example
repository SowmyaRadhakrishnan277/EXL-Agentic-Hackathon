# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=gemini          # gemini | echo (echo = no AI, parser only)
GEMINI_API_KEY=              # free key: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
SPARK_ENGINE=local           # local | databricks
DATABRICKS_HOST=
DATABRICKS_TOKEN=
UC_CATALOG=workspace          # Unity Catalog catalog for bronze/silver/gold schemas
RAW_PATH=                    # Databricks: /Volumes/workspace/bronze/raw (upload data/raw/*.csv there)
LAKEHOUSE_DIR=               # local only; default ./lakehouse
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
